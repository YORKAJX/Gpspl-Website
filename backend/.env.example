NODE_ENV=production
PORT=4000
API_BASE_URL=https://api.gpspl.co.in
FRONTEND_URL=https://gpspl.co.in
TRUST_PROXY=1

DATABASE_URL=postgresql://gpspl:change-me@postgres:5432/gpspl?schema=public&connection_limit=20&pool_timeout=20
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=replace-with-64-character-random-secret
JWT_REFRESH_SECRET=replace-with-another-64-character-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

COOKIE_SECRET=replace-with-cookie-secret
CSRF_COOKIE_NAME=gpspl_csrf

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20
LEAD_RATE_LIMIT_MAX=8

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-smtp-password
MAIL_FROM="GPSPL Website <no-reply@gpspl.co.in>"
LEAD_NOTIFICATION_EMAILS=support@gpspl.co.in,khurana.s@gpspl.co.in,khanna.g@gpspl.co.in

GA4_MEASUREMENT_ID=G-DWG4ZQNV0W
GOOGLE_TAG_MANAGER_ID=
GOOGLE_SEARCH_CONSOLE_VERIFICATION=
MICROSOFT_CLARITY_PROJECT_ID=
VERCEL_ANALYTICS_ENABLED=true

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_MIME=image/jpeg,image/png,image/webp,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

ENABLE_SWAGGER=true
